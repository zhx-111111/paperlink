{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paperlink",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // 保留你在控制台手动设置的 Secrets / 环境变量，部署时不被覆盖。
  // 注意：keep_vars 只保护「变量/密钥」，不保护 KV 这类资源绑定——
  // KV 必须写进下面的 kv_namespaces 才能跨部署持久（见注释）。
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // v4.19：请求先过 Worker 路由、再落静态资源。
    // 默认行为下静态层会把 public/index.html 当目录索引直接应答 "/"，
    // Worker 里「/ → 首页（体验书写板）」的路由永远轮不到执行——线上实测：
    // 根路径返回书写房、匿名访客被弹去登录，能试写的首页只活在 /home。
    // 开了这项，"/" 才真正落到首页；css/js/图片等静态资源仍经 ASSETS 绑定正常下发。
    "run_worker_first": true
  },

  // 全部运行参数已预设（snake_case，见 SPEC §72），可在控制台覆盖。
  "vars": {
    "default_theme": "parchment",
    "idle_timeout_ms": "2500",
    "keep_pages": "10",
    "dormant_after_hour": "24",
    "page_ttl_days": "30",
    "archive_after_pages": "50",
    "max_pts_per_page": "5000",
    "cursor_sync_interval_ms": "200",
    "pressure_min_width": "0.6",
    "pressure_max_width": "2.4",
    "stroke_smoothness": "0.35",
    "speed_min_width": "0.8",
    "speed_max_width": "2.0",
    "pen_response": "pow",
    "pending_page_limit": "3",
    "turnstile_site_key": ""
  },

  // ───────────────────────────────────────────────────────────────
  // KV 存储库绑定（重要 · 请先读这里）
  //
  // wrangler 每次部署都会用本文件的绑定「整体覆盖」线上绑定，
  // 因此只在控制台手动绑定、却不写进这里，下一次推送就会丢失。
  //
  // 正确流程（与 cloud-mail 一致，二选一）：
  //   方式 A（推荐，零改动仓库之外的依赖）：
  //     1) 先部署（此时无 KV，站点提示未绑定，属正常）；
  //     2) 控制台 Storage & Databases → KV → Create namespace（如 paperlink-kv）；
  //     3) 复制该命名空间的 ID，粘贴到下方注释块并取消注释；
  //     4) 提交并推送 → 绑定随配置永久生效，控制台无需再手动绑。
  //   方式 B（GitHub Actions，见 .github/workflows/deploy.yml）：
  //     把 KV ID 存到仓库变量 KV_NAMESPACE_ID，CI 部署时自动注入。
  //
  // ⚠️ 绑定名必须是 PAPERLINK_KV，不可更改。
  // ───────────────────────────────────────────────────────────────
  "kv_namespaces": [
    { "binding": "PAPERLINK_KV", "id": "9a66e86dedc74ad4a148b2c12ca4df80" }
  ],

  "durable_objects": {
    "bindings": [{ "name": "ROOM_DO", "class_name": "RoomDO" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] }
  ],

  // ───────────────────────────────────────────────────────────────
  // D1（可选 · 分担存储压力）
  // 绑定后用户账号表走 D1（照搬 cloud-mail 模式），未绑定则自动回退 KV。
  // 控制台创建 D1 数据库后把 ID 粘进来并取消注释即可（表会自动创建）。
  // ───────────────────────────────────────────────────────────────
  // "d1_databases": [
  //   { "binding": "PAPERLINK_D1", "database_id": "<把你的D1数据库ID粘贴到这里>" }
  // ]
}
