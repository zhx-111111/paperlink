{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paperlink",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 全部参数沿用 snake_case（见 SPEC §72）
  "vars": {
    "default_theme": "tom",
    "idle_timeout_ms": "2500",
    "keep_pages": "10",
    "dormant_after_hour": "24",
    "page_ttl_days": "30",
    "archive_after_pages": "50",
    "max_pts_per_page": "5000",
    "cursor_sync_interval_ms": "200",
    "max_stroke_width": "5.5",
    "turnstile_site_key": ""
  },
  // KV 存储库：无需在此填写 —— 直接部署，部署成功后到 CF 控制台
  // (Workers & Pages → 本 Worker → Settings → Bindings → Add → KV Namespace)
  // 手动绑定，变量名必须填 PAPERLINK_KV。未绑定时站点只读运行（无法注册/书写）。
  // 如需 CLI 管理也可取消下行注释并填入 id：
  "kv_namespaces": [
    // { "binding": "PAPERLINK_KV", "id": "<你的KV命名空间ID>" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM_DO", "class_name": "RoomDO" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] }
  ]
}
